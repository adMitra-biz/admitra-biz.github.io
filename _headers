# Cloudflare Headers Configuration
# This file configures caching behavior for static assets

# Static Images - Cache for 1 year, serve stale while revalidating
/static/images/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

# Videos - Cache for 1 year
/static/videos/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

# Brand Videos - Cache for 1 year
/static/brand_videos/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

# GIFs - Cache for 1 year
/static/gifs/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

# Posters - Cache for 1 year
/static/posters/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

# All static assets - General rule for any missed static files
/static/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

# HTML files - Cache for 1 hour with revalidation
/*.html
  Cache-Control: public, max-age=3600, s-maxage=3600
  Cloudflare-CDN-Cache-Control: public, max-age=3600

# CSS files (if any) - Cache for 1 year
/*.css
  Cache-Control: public, max-age=31536000, s-maxage=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

# JavaScript files (if any) - Cache for 1 year
/*.js
  Cache-Control: public, max-age=31536000, s-maxage=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

# Font files (if any) - Cache for 1 year
/*.woff
  Cache-Control: public, max-age=31536000, s-maxage=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

/*.woff2
  Cache-Control: public, max-age=31536000, s-maxage=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

/*.ttf
  Cache-Control: public, max-age=31536000, s-maxage=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

/*.otf
  Cache-Control: public, max-age=31536000, s-maxage=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

# Security Headers for all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
