# Cache videos for 1 year and allow streaming
/static/brand_videos/*
  Cache-Control: public, max-age=31536000, immutable
  Accept-Ranges: bytes

# Cache images for 1 year
/static/posters/*
  Cache-Control: public, max-age=31536000, immutable
  Accept-Ranges: bytes

# Cache images for 1 year
/static/gifs/*
  Cache-Control: public, max-age=31536000, immutable
  Accept-Ranges: bytes

# Don’t cache HTML (so you can update pages instantly)
/*
  Cache-Control: no-cache