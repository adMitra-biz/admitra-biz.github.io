{
  "name": "admitra-biz-website",
  "version": "1.0.0",
  "description": "AdMitra business website - hyperlocal co-branded advertising platform",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./dist/tailwind.css --watch",
    "dev": "npm run watch:css",
    "build": "npm run build:css",
    "serve": "python -m http.server 8000",
    "deploy": "npm run build && wrangler pages deploy"
  },
  "keywords": ["tailwindcss", "static-site", "cloudflare-pages"],
  "author": "AdMitra",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "tailwindcss": "^3.4.13"
  }
}